<section id="services" class="landing-section landing-services" aria-labelledby="services-heading">
    <div class="landing-container">
        <div class="services-heading" data-reveal>
            <p class="eyebrow eyebrow-dark">Support for every part of student life</p>
            <h2 id="services-heading">Student services</h2>
            <p class="section-lead">Find your place, look after your well-being, and discover the support you need to thrive at NORSU.</p>
        </div>
        <div class="services-banner" data-reveal>
            <img src="{{ asset('images/login-building.jpg') }}" width="1024" height="576" alt="" loading="lazy">
        </div>
        <div class="services-grid">
            {% for service in services %}
                <article class="service-card" data-reveal style="--d: {{ loop.index0 * 0.1 }}s">
                    <span class="service-icon" aria-hidden="true">
                        <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                            {% if service.code == 'SDS' %}
                                <path d="m3 12 13-6 13 6-13 6-13-6Z M8 15v7c5 4 11 4 16 0v-7 M29 12v10"/>
                            {% elseif service.code == 'SWS' %}
                                <path d="M16 26S4 19 4 11a6 6 0 0 1 12-1 6 6 0 0 1 12 1c0 8-12 15-12 15Z"/>
                                <path d="M9 16h4l2-4 3 8 2-4h3"/>
                            {% else %}
                                <circle cx="16" cy="9" r="4"/><circle cx="6" cy="13" r="3"/><circle cx="26" cy="13" r="3"/>
                                <path d="M9 27v-5a7 7 0 0 1 14 0v5 M2 25v-5a4 4 0 0 1 6-3 M30 25v-5a4 4 0 0 0-6-3"/>
                            {% endif %}
                        </svg>
                    </span>
                    <span class="service-code">{{ service.code }}</span>
                    <h3>{{ service.name }}</h3>
                    <p>{{ service.summary }}</p>
                    <a class="service-more" href="{{ path(service.route) }}" aria-label="More about {{ service.name }}">More <span aria-hidden="true">&#8594;</span></a>
                </article>
            {% endfor %}
        </div>
    </div>
</section>
