{% extends 'layouts/landing.html.twig' %}

{% block title %}NORSU-SAS Insight{% endblock %}

{% block main %}
    {# 1. Hero / Welcome #}
    <section id="welcome" class="hero" style="background-image: linear-gradient(180deg, rgba(22, 42, 62, 0.72), rgba(22, 42, 62, 0.88)), url('{{ asset('images/newlogin.jpeg') }}');">
        <div class="hero-inner">
            <div class="hero-emblem">
                <img class="hero-logo" src="{{ asset('images/sas-logo.png') }}" alt="NORSU Student Affairs and Services seal" width="240" height="240" fetchpriority="high">
            </div>
            <h1 class="hero-title">DANGOP</h1>
            <p class="hero-tagline">Integrated Student Affairs &amp; Services Management</p>
            <div class="hero-actions">
                <a class="btn" href="#about">Find out more</a>
            </div>
        </div>
        <svg class="hero-wave" viewBox="0 0 1440 160" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path class="wave-back" d="M0 70 C240 10 520 20 760 70 S1220 130 1440 40 V160 H0 Z"/>
            <path class="wave-mid" d="M0 95 C260 40 540 50 780 100 S1230 150 1440 70 V160 H0 Z"/>
            <path class="wave-front" d="M0 125 C280 80 560 90 800 125 S1240 160 1440 105 V160 H0 Z"/>
        </svg>
    </section>

    {# 2. About #}
    <section id="about" class="landing-section about-us has-highlights">
        <div class="landing-container about-us-grid">
            <div class="about-us-copy" data-reveal>
                <h2 class="about-us-title">About us</h2>
                <span class="about-us-rule" aria-hidden="true"></span>
                <p class="section-lead">The Office of the Vice President for Student Affairs &amp; Services brings together the units that support NORSU students, from guidance and counselling to scholarships, student government and housing. This system gives every campus one place to ask for help and follow it through.</p>
                <a class="btn about-us-btn" href="#campuses">Learn more</a>
                <ul class="about-stats">
                    <li><strong>6</strong><span>Campuses</span></li>
                    <li><strong>{{ directorates|length }}</strong><span>Directorates</span></li>
                    <li><strong>15</strong><span>SAS units</span></li>
                </ul>
            </div>
            <div class="about-us-art" data-reveal style="--d: .1s">
                {{ include('partials/_about_art.html.twig') }}
            </div>
        </div>

        {# Highlights, part of About #}
        <div class="highlights-band">
        <div class="landing-container highlights-grid">
            <article class="highlight-card" data-reveal>
                <svg class="highlight-art" viewBox="0 0 200 150" role="img" aria-label="Illustration of a calendar and a queue ticket" focusable="false">
                    <ellipse class="h-shadow" cx="100" cy="132" rx="70" ry="9"/>
                    <rect class="h-teal" x="42" y="22" width="92" height="88" rx="10"/>
                    <rect class="h-teal-dark" x="42" y="22" width="92" height="20" rx="10"/>
                    <rect class="h-teal-dark" x="62" y="12" width="8" height="18" rx="4"/>
                    <rect class="h-teal-dark" x="106" y="12" width="8" height="18" rx="4"/>
                    <g class="h-line"><rect x="54" y="54" width="14" height="10" rx="3"/><rect x="76" y="54" width="14" height="10" rx="3"/><rect x="98" y="54" width="14" height="10" rx="3"/><rect x="54" y="72" width="14" height="10" rx="3"/><rect class="h-orange" x="76" y="72" width="14" height="10" rx="3"/><rect x="98" y="72" width="14" height="10" rx="3"/><rect x="54" y="90" width="14" height="10" rx="3"/><rect x="76" y="90" width="14" height="10" rx="3"/></g>
                    <rect class="h-orange" x="122" y="70" width="58" height="40" rx="8" transform="rotate(-8 151 90)"/>
                    <text class="h-ticket" x="151" y="96" text-anchor="middle" transform="rotate(-8 151 90)">A-12</text>
                    <circle class="h-pink" cx="170" cy="28" r="9"/>
                </svg>
                <h3>Appointment &amp; Queue</h3>
                <p>Book a slot with any SAS unit and get a queue ticket.</p>
                <a class="highlight-btn" href="{{ path('app_login') }}" data-action="login-morph#open">More</a>
            </article>
            <article class="highlight-card" data-reveal style="--d: .1s">
                <svg class="highlight-art" viewBox="0 0 200 150" role="img" aria-label="Illustration of a shield with a check mark" focusable="false">
                    <ellipse class="h-shadow" cx="100" cy="132" rx="70" ry="9"/>
                    <path class="h-teal" d="M100 14 L148 32 V70 C148 102 128 120 100 130 C72 120 52 102 52 70 V32 Z"/>
                    <path class="h-teal-dark" d="M100 14 L148 32 V70 C148 102 128 120 100 130 Z"/>
                    <path class="h-check" d="M78 72 L94 88 L124 56"/>
                    <rect class="h-orange" x="146" y="86" width="38" height="26" rx="6"/>
                    <path class="h-ticket-line" d="M154 96 H176 M154 103 H168"/>
                    <circle class="h-pink" cx="34" cy="40" r="9"/>
                </svg>
                <h3>Safety and Security Report</h3>
                <p>File a concern and track it until it is resolved.</p>
                <a class="highlight-btn" href="{{ path('app_login') }}" data-action="login-morph#open">More</a>
            </article>
            <article class="highlight-card" data-reveal style="--d: .2s">
                <svg class="highlight-art" viewBox="0 0 200 150" role="img" aria-label="Illustration of a document with a QR code" focusable="false">
                    <ellipse class="h-shadow" cx="100" cy="132" rx="70" ry="9"/>
                    <rect class="h-paper" x="52" y="14" width="96" height="112" rx="8"/>
                    <g class="h-line"><rect x="64" y="26" width="48" height="6" rx="3"/><rect x="64" y="38" width="72" height="5" rx="2.5"/></g>
                    <g class="h-qr"><rect x="68" y="56" width="26" height="26"/><rect x="106" y="56" width="26" height="26"/><rect x="68" y="92" width="26" height="26"/></g>
                    <g class="h-qr-in"><rect x="74" y="62" width="14" height="14"/><rect x="112" y="62" width="14" height="14"/><rect x="74" y="98" width="14" height="14"/></g>
                    <g class="h-qr"><rect x="106" y="92" width="10" height="10"/><rect x="122" y="104" width="10" height="14"/><rect x="108" y="108" width="8" height="10"/></g>
                    <circle class="h-orange" cx="150" cy="108" r="22"/>
                    <path class="h-check h-check-light" d="M140 108 L148 116 L162 100"/>
                    <circle class="h-pink" cx="40" cy="36" r="9"/>
                </svg>
                <h3>Document Verification</h3>
                <p>Request SAS documents and verify them with a QR code.</p>
                <a class="highlight-btn" href="{{ path('app_login') }}" data-action="login-morph#open">More</a>
            </article>
        </div>
        </div>
    </section>

    {# 3. Campuses carousel #}
    <section id="campuses" class="landing-section landing-section-alt">
        <div class="landing-container" data-reveal>
            <p class="eyebrow eyebrow-dark">One university, many campuses</p>
            <h2 id="campuses-heading">Our campuses</h2>
            <p class="section-lead">Student Affairs &amp; Services are available on every NORSU campus. Your requests are routed to the SAS office of your home campus.</p>
        </div>
        {% if slides %}
            <div class="carousel" role="region" aria-roledescription="carousel" aria-labelledby="campuses-heading"
                 data-controller="carousel" data-reveal>
                <div id="campus-carousel-track" class="carousel-track" data-carousel-target="track" tabindex="0"
                     aria-label="Campus photos" aria-describedby="campus-carousel-help" aria-live="off"
                     data-action="keydown.left->carousel#prev:prevent keydown.right->carousel#next:prevent">
                    {% for slide in slides %}
                        <article class="carousel-slide" data-carousel-target="slide" role="group" aria-roledescription="slide"
                                 aria-label="{{ loop.index }} of {{ slides|length }}: {{ slide.campus.name }}">
                            <img src="{{ asset(slide.image) }}" alt="" loading="lazy" draggable="false">
                            <div class="carousel-caption">
                                <span class="campus-code">{{ slide.campus.code }}</span>
                                <h3>{{ slide.campus.name }}</h3>
                            </div>
                        </article>
                    {% endfor %}
                </div>
                <button type="button" class="carousel-btn carousel-prev" aria-label="Previous campus" aria-controls="campus-carousel-track"
                        data-carousel-target="previous" data-action="carousel#prev" hidden>&#8249;</button>
                <button type="button" class="carousel-btn carousel-next" aria-label="Next campus" aria-controls="campus-carousel-track"
                        data-carousel-target="next" data-action="carousel#next" hidden>&#8250;</button>
                <p id="campus-carousel-help" class="carousel-help">Swipe or scroll to explore campuses. Use the left and right arrow keys when the photos are focused.</p>
            </div>
        {% else %}
            <p class="landing-empty landing-container">Campus list coming soon.</p>
        {% endif %}
    </section>

    {# 4. People — glass 3D org chart #}
    <section id="people" class="landing-section landing-people">
        <div class="aurora" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="landing-container">
            <div class="people-heading" data-reveal>
                <p class="eyebrow">People behind student support</p>
                <h2>Office of the Vice President</h2>
                <p class="section-lead">Student Affairs &amp; Services</p>
            </div>
            <figure class="org-chart" data-reveal>
                <div class="org-tilt" data-controller="tilt" data-tilt-max-value="4" data-action="mousemove->tilt#move mouseleave->tilt#reset">
                    <div class="org-glass">
                        <img class="org-chart-image" src="{{ asset('images/sas-org-chart.jpg') }}" width="1400" height="2100" loading="lazy"
                             alt="Organizational chart of the Office of the Vice President for Student Affairs and Services: the University President, the Vice President for Student Affairs and Services, his secretary and office staff, the directors of Student Development Services, Student Welfare Services and Institutional Student Programs and Services, and the heads of each SAS unit.">
                    </div>
                </div>
            </figure>
        </div>
    </section>

    {# 5. Student services #}
    {{ include('home/_student_services.html.twig', {services: student_services}, with_context: false) }}

    {# 6. Latest announcements #}
    <section id="announcements" class="landing-section landing-announcements" aria-labelledby="announcements-heading">
        <div class="landing-container">
            <div class="announce-heading" data-reveal>
                <span class="announce-megaphone" aria-hidden="true">
                    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 13v6h4l10 6V7L8 13H4Z"/><path d="M22 12a5 5 0 0 1 0 8M25 9a9 9 0 0 1 0 14"/></svg>
                </span>
                <p class="eyebrow">What's new</p>
                <h2 id="announcements-heading">Latest announcements</h2>
            </div>
            <div class="announce-grid">
                <a class="announce-poster" href="{{ path('app_channel_tn') }}" data-reveal aria-label="The NORSUnian announcements">
                    <img src="{{ asset('images/announcements/the-norsunian.webp') }}" width="760" height="1048" alt="Announcement from @The NORSUnian: The NORSUnian (TN) is the official weekly student publication of Negros Oriental State University." loading="lazy">
                </a>
                <a class="announce-poster" href="{{ path('app_channel_hadurawan') }}" data-reveal style="--d: .1s" aria-label="HADURAWAN announcements">
                    <img src="{{ asset('images/announcements/hadurawan.webp') }}" width="760" height="1048" alt="Announcement from @HADURAWAN: HADURAWAN NORSU showcases the creativity, talents, and artistic expressions of the NORSU community." loading="lazy">
                </a>
                <a class="announce-poster" href="{{ path('app_channel_norsu_media') }}" data-reveal style="--d: .2s" aria-label="NORSU Media announcements">
                    <img src="{{ asset('images/announcements/norsu-media.webp') }}" width="760" height="1048" alt="Announcement from @NORSU Media: NORSU Media shares university news, events, and updates to keep the NORSU community informed and connected." loading="lazy">
                </a>
            </div>
        </div>
    </section>

    {# 7. Team #}
    {{ include('home/_team.html.twig', {team: team}, with_context: false) }}
{% endblock %}
