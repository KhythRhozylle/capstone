{% set route = app.request.attributes.get('_route') %}
{% set operations = [
    {label: 'Dashboard', route: 'vpsas_dashboard', icon: 'dashboard', active: route in ['vpsas_dashboard', 'staff_dashboard']},
    {label: 'Appointments', route: 'staff_appointments', icon: 'clock', active: route starts with 'staff_appointment' or route starts with 'vpsas_availability' or route starts with 'staff_office_hours'},
    {label: 'Concerns', route: 'staff_concerns', icon: 'chat', active: route starts with 'staff_concern'},
    {label: 'Document tracking and monitoring', route: 'staff_documents', icon: 'document', active: route starts with 'staff_document' or route starts with 'office_document'},
    {label: 'Announcements', route: 'staff_announcements', icon: 'announcement', active: route starts with 'staff_announcement'},
    {label: 'Documentation guide', route: 'documentation_index', icon: 'document', active: route starts with 'documentation_'},
    {label: 'Feedbacks', route: 'vpsas_feedback', icon: 'star', active: route == 'vpsas_feedback'}
] %}
{% include 'partials/_sidebar.html.twig' with {label: 'VPSAS navigation', groups: [{label: 'Workspace', items: operations}, {label: 'Activity logs', items: [{label: 'Activity log', route: 'vpsas_profile_activity', icon: 'clock', active: route == 'vpsas_profile_activity'}]}]} only %}
