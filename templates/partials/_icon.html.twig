<svg class="{{ class|default('app-icon') }}" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {% if name == 'dashboard' %}
        <rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>
    {% elseif name == 'calendar' %}
        <rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18M8 15h2M14 15h2M8 18h2"/>
    {% elseif name == 'clock' %}
        <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
    {% elseif name == 'request' %}
        <rect x="5" y="5" width="14" height="16" rx="2"/><path d="M9 3h6v4H9zM9 11h6M9 15h4"/>
    {% elseif name == 'chat' %}
        <path d="M21 11a8 8 0 0 1-8 8H7l-4 3V11a8 8 0 0 1 8-8h2a8 8 0 0 1 8 8Z"/><path d="M7 10h10M7 14h7"/>
    {% elseif name == 'document' %}
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Z"/><path d="M14 2v6h6M8 13h8M8 17h5"/>
    {% elseif name == 'queue' %}
        <circle cx="9" cy="7" r="3"/><path d="M3 21v-3a6 6 0 0 1 12 0v3M16 4a3 3 0 0 1 0 6M18 15a5 5 0 0 1 3 5"/>
    {% elseif name == 'announcement' %}
        <path d="m3 9 15-5v16L3 15V9ZM7 16l1 5h4l-2-4M21 9v6"/>
    {% elseif name == 'profile' %}
        <circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/>
    {% elseif name == 'bell' %}
        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/>
    {% elseif name == 'care' %}
        <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/><path d="M7 12h3l2-4 2 8 1-4h3"/>
    {% elseif name == 'chart' %}
        <path d="M3 3v18h18M7 16v-4M12 16V7M17 16v-7"/>
    {% elseif name == 'home' %}
        <path d="m3 10 9-7 9 7M5 9v12h14V9M9 21v-8h6v8"/>
    {% elseif name == 'menu' %}
        <path d="M4 6h16M4 12h16M4 18h16"/>
    {% elseif name == 'logout' %}
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/>
    {% elseif name == 'close' %}
        <path d="m6 6 12 12M6 18 18 6"/>
    {% elseif name == 'chevron' %}
        <path d="m9 6 6 6-6 6"/>
    {% elseif name == 'arrow' %}
        <path d="M4 12h16m-6-6 6 6-6 6"/>
    {% elseif name == 'check' %}
        <path d="m5 12 4 4L19 6"/>
    {% elseif name == 'search' %}
        <circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/>
    {% endif %}
</svg>
