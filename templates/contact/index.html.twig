{% extends 'layouts/landing.html.twig' %}

{% block title %}Contact · NORSU-SAS Insight{% endblock %}
{% block page_class %}contact-page{% endblock %}

{% macro field(field, index) %}
    {% set has_errors = field.vars.errors|length > 0 %}
    <div class="cf-field" style="--i: {{ index }}">
        {{ form_label(field) }}
        {{ form_widget(field, {attr: has_errors ? {'aria-invalid': 'true', 'aria-describedby': field.vars.id ~ '-errors'} : {}}) }}
        {% if has_errors %}
            <div class="cf-field-errors" id="{{ field.vars.id }}-errors">{{ form_errors(field) }}</div>
        {% endif %}
    </div>
{% endmacro %}

{% block main %}
<section class="contact-hero">
    <div class="aurora" aria-hidden="true"><span></span><span></span><span></span></div>

    <div class="contact-wrap">
        <div class="contact-copy">
            <p class="eyebrow">Contact</p>
            <h1>Get In Touch</h1>
            <p class="contact-lead">Questions about appointments, documents or student support? Send us a message and the Student Affairs &amp; Services team will get back to you.</p>

            <ul class="contact-details">
                <li>
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
                    <span>{{ contact.address }}</span>
                </li>
                <li>
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                    <span>{{ contact.office_hours }}</span>
                </li>
                <li>
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
                    <a href="mailto:{{ contact.email }}">{{ contact.email }}</a>
                </li>
            </ul>

            <ul class="contact-list">
                {% for phone in contact.phones %}
                    <li>
                        <span>{{ phone.label }}</span>
                        <a href="tel:{{ phone.number|replace({' ': '', '(': '', ')': '', '-': ''}) }}">{{ phone.number }}</a>
                    </li>
                {% endfor %}
            </ul>

            <a class="arrow-btn" href="{{ path('app_home') }}" aria-label="Back to home">
                <svg viewBox="0 0 64 24" width="64" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M62 12H4M14 3l-10 9 10 9"/></svg>
            </a>
        </div>

        <div class="contact-card-wrap" data-controller="tilt" data-tilt-max-value="3" data-action="mousemove->tilt#move mouseleave->tilt#reset">
            {{ form_start(form, {attr: {class: 'contact-card', novalidate: 'novalidate', 'aria-labelledby': 'contact-form-title'}}) }}
                <div class="cf-intro">
                    <h2 id="contact-form-title">Send a message</h2>
                    <p>Tell us how we can help.</p>
                </div>

                {% if form.vars.submitted and not form.vars.valid %}
                    <div class="cf-errors" role="alert">
                        <p>Your message could not be sent. Review the details below.</p>
                        {{ form_errors(form) }}
                    </div>
                {% endif %}

                {{ _self.field(form.name, 1) }}

                <div class="cf-row">
                    {{ _self.field(form.email, 2) }}
                    {{ _self.field(form.phone, 3) }}
                </div>

                {{ _self.field(form.message, 4) }}

                <p class="cf-note">All fields are required except your phone number.</p>

                <div class="cf-actions" style="--i: 5">
                    <button type="submit" class="cf-submit">
                        <span>Submit</span>
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M2.5 21.5 23 12 2.5 2.5l.01 7.4L17 12 2.51 14.1z"/></svg>
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</section>
{% endblock %}
