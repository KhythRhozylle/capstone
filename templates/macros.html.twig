

{% macro status_badge(label) %}
    <span class="badge badge-{{ label|lower|replace({' ': '-', '_': '-'}) }}">{{ label }}</span>
{% endmacro %}

{% macro data_table(headers, rows) %}
    <div class="table-wrap">
        <table class="data-table">
            <thead><tr>{% for h in headers %}<th scope="col">{{ h }}</th>{% endfor %}</tr></thead>
            <tbody>
            {% for row in rows %}
                <tr>{% for cell in row %}<td>{{ cell|raw }}</td>{% endfor %}</tr>
            {% else %}
                <tr><td colspan="{{ headers|length }}"><div class="empty-state"><strong>No records yet</strong><p>New records will appear here.</p></div></td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endmacro %}

{% macro history_list(items) %}
    <ul class="timeline">
        {% for item in items %}
            <li>
                <small class="timeline-date">{{ item.createdAt|date('M j, Y g:i A') }}</small>
                <div class="timeline-status">{% if item.fromStatus %}{{ item.fromStatus|replace({'_': ' '})|title }} &rarr; {% endif %}<strong>{{ item.toStatus|replace({'_': ' '})|title }}</strong></div>
                {% if item.actor %}<span class="muted">{{ item.actor.fullName }}</span>{% endif %}
                {% if item.note %}<p class="muted">{{ item.note }}</p>{% endif %}
            </li>
        {% else %}
            <li class="muted">No status updates yet.</li>
        {% endfor %}
    </ul>
{% endmacro %}
