{% extends 'layouts/landing.html.twig' %}

{% block title %}Office of the Vice President · NORSU-SAS Insight{% endblock %}
{% block page_class %}vpsas-office-page{% endblock %}

{% block main %}
    <section class="landing-section landing-section-alt vpsas-office" aria-labelledby="vpsas-title">
        <div class="landing-container" data-controller="office-team">
            <a class="service-back" href="{{ path('app_home') }}#services">Back</a>
            <div class="vpsas-heading" data-reveal>
                <p class="eyebrow eyebrow-dark">VPSAS</p>
                <h1 id="vpsas-title" class="service-detail-title">Office of the Vice President for Student Affairs &amp; Services</h1>
            </div>

            <div class="vpsas-leader" data-reveal>
                <button type="button" class="vpsas-face" data-office-team-target="trigger" data-action="office-team#toggle"
                        aria-expanded="false" aria-controls="vpsas-team"
                        aria-label="Dr. Cesar P. Estrope. Show or hide the office staff and secretary">
                    <img src="{{ asset('images/vpsas/vice-president.jpg') }}" width="360" height="360" alt="Portrait of Dr. Cesar P. Estrope">
                </button>
                <h2 class="vpsas-name">Dr. Cesar P. Estrope</h2>
                <p class="vpsas-position">Vice President, Student Affairs &amp; Services</p>
                <p class="vpsas-details">The Vice President leads the Office of Student Affairs &amp; Services, which oversees Student Development Services, Student Welfare Services and Institutional Student Programs &amp; Services across every NORSU campus.</p>
                <p class="vpsas-hint">Select the portrait to meet the office team.</p>
            </div>

            <div id="vpsas-team" class="vpsas-team" data-office-team-target="panel" hidden>
                <article class="vpsas-member">
                    <img src="{{ asset('images/vpsas/office-staff.jpg') }}" width="300" height="300" alt="Portrait of Mark Raymund P. Baldado" loading="lazy">
                    <h3>Mark Raymund P. Baldado</h3>
                    <p>Office Staff</p>
                </article>
                <article class="vpsas-member">
                    <img src="{{ asset('images/vpsas/secretary.jpg') }}" width="300" height="300" alt="Portrait of Dianne Gutual-Futalan" loading="lazy">
                    <h3>Dianne Gutual-Futalan</h3>
                    <p>Secretary</p>
                </article>
            </div>
        </div>
    </section>
{% endblock %}
