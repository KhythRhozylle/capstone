{% extends office_profile(app.user) ? 'layouts/vpsas.html.twig' : (is_granted('ROLE_STUDENT') ? 'layouts/portal.html.twig' : 'layouts/staff.html.twig') %}
{% block title %}{{ unit.name }} availability{% endblock %}
{% block content %}
<div data-controller="office-availability">
<div class="page-header"><div><h1>{{ unit.name }} availability</h1><p>Grey dates are unavailable all day. Other unavailable times are listed below.{% if owner %} Only this account can change its availability.{% endif %}</p></div>{% if owner %}<a class="btn btn-outline" href="{{ path('staff_appointments') }}">Appointments</a>{% endif %}</div>
{% if owner %}<section class="panel" data-office-availability-target="form" {% if not form.vars.submitted %}hidden{% endif %}>{{ form_start(form) }}{{ form_row(form.day, {attr: {'data-office-availability-target': 'date'}}) }}{{ form_row(form.startMinute) }}{{ form_row(form.endMinute) }}{{ form_errors(form) }}<button class="btn" type="submit">Mark unavailable</button>{{ form_end(form) }}</section>{% endif %}
<section class="panel"><div class="page-header"><a href="{{ path(availabilityRoute, availabilityParams|merge({year: month|date_modify('-1 month')|date('Y'), month: month|date_modify('-1 month')|date('n')})) }}" aria-label="Previous month">&larr;</a><h2>{{ month|date('F Y') }}</h2><a href="{{ path(availabilityRoute, availabilityParams|merge({year: month|date_modify('+1 month')|date('Y'), month: month|date_modify('+1 month')|date('n')})) }}" aria-label="Next month">&rarr;</a></div>
<div class="office-availability-grid">{% for day in ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'] %}<strong>{{ day }}</strong>{% endfor %}
{% for day in dates %}{% set key = day|date('Y-m-d') %}
    {% if owner %}
        {% set existing = null %}{% for entry in entries %}{% if entry.day|date('Y-m-d') == key and entry.allDay %}{% set existing = entry %}{% endif %}{% endfor %}
        {% if existing %}<form method="post" action="{{ path(unit.code == 'VPSAS' ? 'vpsas_availability_delete' : 'staff_availability_delete', {id: existing.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('availability-delete-' ~ existing.id) }}"><button class="office-availability-day is-unavailable" type="submit" aria-label="Make available on {{ key }}">{{ day|date('j') }}<small>Unavailable</small></button></form>
        {% else %}<button class="office-availability-day{{ day|date('m') != month|date('m') ? ' is-outside' : '' }}" type="button" data-action="office-availability#choose" data-office-availability-day-param="{{ key }}" aria-label="Set availability on {{ key }}">{{ day|date('j') }}</button>{% endif %}
    {% else %}<span class="office-availability-day{{ key in blocked ? ' is-unavailable' : '' }}{{ day|date('m') != month|date('m') ? ' is-outside' : '' }}" {% if key in blocked %}aria-disabled="true" title="{{ unit.name }} unavailable"{% endif %}>{{ day|date('j') }}{% if key in blocked %}<small>Unavailable</small>{% endif %}</span>{% endif %}
{% endfor %}</div></section>
{% if not owner %}<section class="panel"><h2>Unavailable periods</h2>{% for entry in publicPeriods %}<p>{{ entry.day|date('M j, Y') }} · {{ entry.periodLabel }}</p>{% else %}<p>No unavailable periods.</p>{% endfor %}</section>{% endif %}
{% if owner %}<section class="panel"><h2>Unavailable periods</h2>{% for entry in entries %}<form class="availability-entry" method="post" action="{{ path(unit.code == 'VPSAS' ? 'vpsas_availability_delete' : 'staff_availability_delete', {id: entry.id}) }}"><span>{{ entry.day|date('M j, Y') }} · {{ entry.periodLabel }}</span><input type="hidden" name="_token" value="{{ csrf_token('availability-delete-' ~ entry.id) }}"><button class="btn btn-outline" type="submit">Make available</button></form>{% else %}<p>No dates marked unavailable.</p>{% endfor %}</section>{% endif %}
</div>
{% endblock %}
