{% extends 'layouts/staff.html.twig' %}
{% import 'macros.html.twig' as ui %}
{% block title %}Appointment calendar{% endblock %}
{% block content %}
<div class="page-header">
    <div><h1>Appointment calendar</h1><p class="page-description">Plan the week ahead, one student visit at a time.</p></div>
    <a class="btn btn-outline" href="{{ path('staff_appointments') }}">List view</a>
</div>
<section class="panel">
    <div class="panel-header"><div><p class="panel-kicker">Weekly schedule</p><h2 class="panel-title">{{ start|date('M j') }} &ndash; {{ end|date('M j, Y') }}</h2></div></div>
<div class="calendar-grid">
{% for day in days %}
    <section class="calendar-day">
        <div class="calendar-day-heading"><h3>{{ day.label }}</h3><span class="calendar-count">{{ day.items|length }}</span></div>
        <ul class="calendar-events">
            {% for a in day.items %}
                <li class="calendar-event">
                    <a class="table-link" href="{{ path('staff_appointment_show', {id: a.id}) }}"><span class="calendar-time">{{ a.scheduledAt|date('g:i A') }}</span><strong>{{ a.student.fullName }}</strong></a>
                    <p class="muted">{{ a.unit.name }}</p>
                    {{ ui.status_badge(a.status.label) }}
                </li>
            {% else %}
                <li class="calendar-empty">No appointments</li>
            {% endfor %}
        </ul>
    </section>
{% endfor %}
</div>
</section>
{% endblock %}
