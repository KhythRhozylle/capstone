{% extends 'layouts/staff.html.twig' %}
{% import 'macros.html.twig' as ui %}
{% block title %}Document tracking and monitoring{% endblock %}
{% block content %}
<div class="page-header"><div><h1>Document tracking and monitoring</h1><p class="page-description">Record documents received by your office and monitor their release.</p></div></div>
<section class="panel panel-table" data-controller="document-sheet"><div class="panel-header"><div><p class="panel-kicker">Office register</p><h2 class="panel-title">Received documents</h2></div><div class="sheet-toolbar">{% if newRecordForm %}<details class="sheet-insert"><summary class="btn btn-outline">Insert ▾</summary><div class="sheet-insert-options"><label class="sheet-row-count">Number of rows<select data-row-count aria-label="Number of rows">{% for count in 1..20 %}<option value="{{ count }}">{{ count }}</option>{% endfor %}</select></label><button type="button" data-action="document-sheet#addRow" data-url="{{ path('office_document_row') }}">Add rows</button><button type="button" data-action="document-sheet#showColumn">Add columns</button></div></details>{% endif %}<a class="btn btn-outline" href="{{ path('office_documents_print') }}" target="_blank" rel="noopener">Print register</a> <a class="btn btn-outline" href="{{ path('office_documents_pdf') }}" data-turbo="false">Download PDF</a></div></div><p class="sheet-toolbar-message" data-sheet-message role="status" aria-live="polite"></p>{% if columnForm %}<div class="sheet-column-editor" data-column-editor hidden>{{ form_start(columnForm) }}{{ form_row(columnForm.count) }}{{ form_row(columnForm.label) }}{{ form_widget(columnForm._token) }}<button class="btn btn-primary" type="submit">Insert column</button><button class="btn btn-outline" type="button" data-action="document-sheet#hideColumn">Cancel</button>{{ form_end(columnForm, {render_rest: false}) }}</div>{% endif %}{{ include('staff/document_records/_table.html.twig', {records: records}) }}</section>
<section class="panel panel-table">
    <div class="panel-header"><div><p class="panel-kicker">Records &amp; documents</p><h2 class="panel-title">Student document requests</h2></div><span class="badge">{{ documents|length }} total</span></div>
    <div class="table-wrap"><table class="data-table">
        <thead><tr><th scope="col">Reference</th><th scope="col">Student</th><th scope="col">Document type</th><th scope="col">Status</th><th scope="col">Action</th></tr></thead>
        <tbody>
        {% for d in documents %}
            <tr><td><a class="table-link" href="{{ path('staff_document_show', {id: d.id}) }}">{{ d.referenceCode }}</a></td><td>{{ d.student.fullName }}</td><td>{{ d.documentType.label }}</td><td>{{ ui.status_badge(d.status.label) }}</td><td><a class="btn btn-sm btn-outline" href="{{ path('staff_document_show', {id: d.id}) }}">Review</a></td></tr>
        {% else %}
            <tr><td colspan="5"><div class="empty-state"><strong>No documents to track yet</strong><p>New student requests will appear here for review.</p></div></td></tr>
        {% endfor %}
        </tbody>
    </table></div>
</section>
{% endblock %}
