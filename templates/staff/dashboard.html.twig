{% extends 'layouts/staff.html.twig' %}
{% import 'macros.html.twig' as ui %}
{% block title %}Dashboard{% endblock %}
{% block content %}
<div class="page-header">
    <div><h1>{% if app.user.email|lower == 'vpsas@norsu.edu.ph' %}Welcome back, Admin!{% else %}Welcome, {{ app.user.fullName }}!{% endif %} <span class="wave" aria-hidden="true">&#128075;</span></h1><p class="page-description"> {% if scope.unrestricted %}Your university-wide SAS overview.{% else %}{{ scope.unit ? scope.unit.name : 'All units' }} &middot; {{ scope.campus ? scope.campus.name : 'All campuses' }}{% endif %}</p></div>
    <a class="btn btn-outline btn-sm" href="{{ path('staff_appointment_calendar') }}">{{ include('partials/_icon.html.twig', {name: 'calendar'}) }}View calendar</a>
</div>
{% set events = [] %}
{% for a in appointments %}{% set events = events|merge([{date: a.scheduledAt|date('Y-m-d'), time: a.scheduledAt|date('g:i A'), title: a.student.fullName, sub: a.unit.name, status: a.status.label, url: path('staff_appointment_show', {id: a.id})}]) %}{% endfor %}
<div class="dash-layout">
<div class="dash-main">
{% set routes = ['staff_appointments', 'staff_concerns', 'staff_services', 'staff_documents'] %}
<div class="metric-grid">
    {% for category in activity.categories %}
        {% if not staff_workspace(app.user) or routes[loop.index0] != 'staff_services' %}<a class="metric-card" href="{{ path(routes[loop.index0]) }}"><span class="metric-icon metric-icon-{{ loop.index }}">{{ include('partials/_icon.html.twig', {name: category.icon}) }}</span><div><p class="metric-label">{{ category.label }}</p><strong class="metric-value">{{ category.total }}</strong><span class="metric-caption">{{ category.open }} open &middot; {{ category.closed }} closed</span></div></a>{% endif %}
    {% endfor %}
</div>
{{ include('partials/_activity_charts.html.twig') }}
<div class="dashboard-bottom">
    <section class="panel campus-feature">
        <img src="{{ asset('images/login-building.jpg') }}" alt="" loading="lazy">
        <div><span class="panel-kicker">Student Affairs &amp; Services</span><h2>{{ scope.campus ? scope.campus.name : 'One university. Every student.' }}</h2><p>A connected workspace for appointments, requests, and student support.</p>{% if staff_workspace(app.user) %}<a href="{{ path('staff_appointments') }}">View appointments &rarr;</a>{% else %}<a href="{{ path('staff_services') }}">View service requests &rarr;</a>{% endif %}</div>
    </section>
    <section class="panel panel-table">
        <div class="panel-header"><div><h2 class="panel-title">Recent appointments</h2><p class="panel-kicker">Latest scheduled visits in your workspace</p></div><a class="panel-link" href="{{ path('staff_appointments') }}">View all &rarr;</a></div>
        <div class="table-wrap"><table class="data-table"><thead><tr><th>Student</th><th>Schedule</th><th>Status</th><th></th></tr></thead><tbody>
        {% for appointment in appointments|slice(0, 5) %}<tr><td><strong>{{ appointment.student.fullName }}</strong><small class="cell-secondary">{{ appointment.referenceCode }}</small></td><td>{{ appointment.scheduledAt|date('M j, Y') }}<small class="cell-secondary">{{ appointment.scheduledAt|date('g:i A') }}</small></td><td>{{ ui.status_badge(appointment.status.label) }}</td><td><a class="table-link" href="{{ path('staff_appointment_show', {id: appointment.id}) }}">Open</a></td></tr>
        {% else %}<tr><td colspan="4" class="empty-state">No appointments yet. Scheduled visits will appear here.</td></tr>{% endfor %}
        </tbody></table></div>
    </section>
</div>
</div>
<aside class="dash-aside" aria-label="Schedule and shortcuts">
    {% if not staff_workspace(app.user) %}
    {{ include('partials/_promo_card.html.twig', {kicker: 'Walk-in queue', title: 'Serve the next student', text: 'Call the next ticket and keep the line moving.', cta: 'Open queue', route: 'staff_queue'}) }}
    {% endif %}
    {{ include('partials/_calendar_widget.html.twig', {events: events, calendar_route: 'staff_appointment_calendar'}) }}
</aside>
</div>
{% endblock %}
