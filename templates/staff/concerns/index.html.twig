{% extends 'layouts/staff.html.twig' %}
{% import 'macros.html.twig' as ui %}
{% block title %}Concerns{% endblock %}
{% block content %}
<div class="page-header"><div><h1>Concerns</h1><p class="page-description">Give student concerns the attention and follow-through they need.</p></div></div>
<section class="panel panel-table">
    <div class="panel-header"><div><p class="panel-kicker">Student assistance</p><h2 class="panel-title">Concern overview</h2></div><span class="badge">{{ concerns|length }} total</span></div>
    <div class="table-wrap"><table class="data-table">
        <thead><tr><th scope="col">Reference</th><th scope="col">Type</th><th scope="col">Student</th><th scope="col">Status</th><th scope="col">Action</th></tr></thead>
        <tbody>
        {% for c in concerns %}
            <tr><td><a class="table-link" href="{{ path('staff_concern_show', {id: c.id}) }}">{{ c.referenceCode }}</a></td><td>{{ c.type.label }}</td><td>{{ c.student.fullName }}</td><td>{{ ui.status_badge(c.status.label) }}</td><td><a class="btn btn-sm btn-outline" href="{{ path('staff_concern_show', {id: c.id}) }}">Review</a></td></tr>
        {% else %}
            <tr><td colspan="5"><div class="empty-state"><strong>No concerns to review</strong><p>Student concerns assigned to your office will appear here.</p></div></td></tr>
        {% endfor %}
        </tbody>
    </table></div>
</section>
{% endblock %}
