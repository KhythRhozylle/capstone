{% extends 'layouts/portal.html.twig' %}
{% import 'macros.html.twig' as ui %}
{% block title %}Service requests{% endblock %}
{% block content %}
<div class="page-header"><div><h1>Service requests</h1><p class="page-description">Ask for assistance and follow the progress of each request.</p></div><a class="btn" href="{{ path('portal_service_new') }}">New request</a></div>
<section class="panel panel-table">
    <div class="panel-header"><div><p class="panel-kicker">Student support</p><h2 class="panel-title">Your requests</h2></div><span class="badge">{{ requests|length }} total</span></div>
    <div class="table-wrap"><table class="data-table">
        <thead><tr><th scope="col">Reference</th><th scope="col">Unit</th><th scope="col">Subject</th><th scope="col">Status</th><th scope="col">Action</th></tr></thead>
        <tbody>{% for r in requests %}<tr><td><a class="table-link" href="{{ path('portal_service_show', {id: r.id}) }}">{{ r.referenceCode }}</a></td><td>{{ r.unit.name }}</td><td>{{ r.subject }}</td><td>{{ ui.status_badge(r.status.label) }}</td><td><a class="btn btn-sm btn-outline" href="{{ path('portal_service_show', {id: r.id}) }}">View</a></td></tr>{% else %}<tr><td colspan="5"><div class="empty-state"><strong>No service requests yet</strong><p>Submit a request whenever you need help from student services.</p><a class="btn btn-outline" href="{{ path('portal_service_new') }}">New request</a></div></td></tr>{% endfor %}</tbody>
    </table></div>
</section>
{% endblock %}
