{% extends 'layouts/portal.html.twig' %}
{% import 'macros.html.twig' as ui %}
{% block title %}Document tracking and monitoring{% endblock %}
{% block content %}
<div class="page-header"><div><h1>Document tracking and monitoring</h1><p class="page-description">Request SAS documents and track when they are ready for release.</p></div><a class="btn" href="{{ path('portal_document_new') }}">Request document</a></div>
<section class="panel panel-table">
    <div class="panel-header"><div><p class="panel-kicker">Records &amp; documents</p><h2 class="panel-title">Your documents</h2></div><span class="badge">{{ documents|length }} total</span></div>
    <div class="table-wrap"><table class="data-table">
        <thead><tr><th scope="col">Reference</th><th scope="col">Document type</th><th scope="col">Status</th><th scope="col">Action</th></tr></thead>
        <tbody>{% for d in documents %}<tr><td><a class="table-link" href="{{ path('portal_document_show', {id: d.id}) }}">{{ d.referenceCode }}</a></td><td>{{ d.documentType.label }}</td><td>{{ ui.status_badge(d.status.label) }}</td><td><a class="btn btn-sm btn-outline" href="{{ path('portal_document_show', {id: d.id}) }}">View</a></td></tr>{% else %}<tr><td colspan="4"><div class="empty-state"><strong>No documents to track yet</strong><p>Your requested documents and release updates will appear here.</p><a class="btn btn-outline" href="{{ path('portal_document_new') }}">Request document</a></div></td></tr>{% endfor %}</tbody>
    </table></div>
</section>
{% endblock %}
