{% extends 'layouts/portal.html.twig' %}
{% block title %}{{ title }}{% endblock %}
{% block content %}
<div class="page-header"><div><h1>{{ title }}</h1><p class="page-description">Choose an office, schedule, and visit mode for your appointment.</p></div><a class="btn btn-outline" href="{{ appointment is defined ? path('portal_appointment_show', {id: appointment.id}) : path('portal_appointments') }}">{{ appointment is defined ? 'Back to appointment' : 'Back to appointments' }}</a></div>
{% if appointment is defined %}<p class="flash flash-info">Saving changes returns this appointment to pending staff approval. Staff will provide a meeting link after approving a virtual appointment.</p>{% endif %}
<p><a href="{{ path('office_availability_directory') }}">View office availability</a></p>
<section class="panel form-panel"><div class="panel-header"><div><p class="panel-kicker">Student visit</p><h2 class="panel-title">Appointment details</h2></div></div>{% include 'partials/_form.html.twig' with {form: form, submit_label: submit_label|default('Submit request')} %}</section>
{% endblock %}
