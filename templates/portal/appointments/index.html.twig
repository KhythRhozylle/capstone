{% extends 'layouts/portal.html.twig' %}
{% import 'macros.html.twig' as ui %}
{% block title %}Appointments{% endblock %}
{% block content %}
<div class="people-header">
    <div><h1>Appointments</h1><p class="people-sub">Book a student services visit and track your upcoming appointments.</p></div>
    <a class="people-add" href="{{ path('portal_appointment_officials') }}">{{ include('partials/_icon.html.twig', {name: 'calendar'}) }}Book appointment</a>
</div>
<section class="people-card" data-controller="paged-table" data-paged-table-per-page-value="5" aria-label="Appointment overview">
    <table class="people-table">
        <thead><tr><th scope="col">Office</th><th scope="col">Status</th><th scope="col">Schedule</th><th scope="col">Reference</th><th scope="col">Action</th></tr></thead>
        <tbody>
        {% for a in appointments %}
            <tr data-paged-table-target="row">
                <td><div class="person"><span class="avatar av-{{ a.id % 5 }}" aria-hidden="true">{{ a.unit.name|slice(0, 2)|upper }}</span><div><strong>{{ a.unit.name }}</strong><small>{{ a.campus.name }}</small></div></div></td>
                <td>{{ ui.status_pill(a.status.value, a.status.label) }}</td>
                <td><span class="figure">{{ a.scheduledAt|date('M j') }}</span> <span class="figure-unit">{{ a.scheduledAt|date('Y') }}</span><small class="sub">{{ a.scheduledAt|date('g:i A') }} &middot; {{ a.mode.label }}</small></td>
                <td><span class="figure figure-ref">{{ a.referenceCode }}</span></td>
                <td><a class="people-edit" href="{{ path('portal_appointment_show', {id: a.id}) }}">{{ include('partials/_icon.html.twig', {name: 'request'}) }}View</a></td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {% if not appointments %}
        <div class="empty-state"><strong>No appointments yet</strong><p>Book your first visit to connect with a student services office.</p><a class="people-edit" href="{{ path('portal_appointment_officials') }}">Book appointment</a></div>
    {% endif %}
    <nav class="people-pages" aria-label="Appointment pages" data-paged-table-target="nav"></nav>
</section>
{% endblock %}
