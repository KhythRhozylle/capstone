{% extends 'layouts/portal.html.twig' %}
{% block title %}Dashboard{% endblock %}
{% block content %}
<div class="page-header">
    <div><h1>Welcome back, Admin! <span class="wave" aria-hidden="true">&#128075;</span></h1><p class="page-description">{{ app.user.campus ? app.user.campus.name : 'Your student workspace' }} &middot; {{ unreadCount }} unread notification{{ unreadCount == 1 ? '' : 's' }}</p></div>
    <a class="btn btn-sm" href="{{ path('portal_appointment_officials') }}">{{ include('partials/_icon.html.twig', {name: 'calendar'}) }}Book appointment</a>
</div>
{% set events = [] %}
{% for a in appointments %}{% set events = events|merge([{date: a.scheduledAt|date('Y-m-d'), time: a.scheduledAt|date('g:i A'), title: a.unit.name, sub: a.mode.label, status: a.status.label, url: path('portal_appointment_show', {id: a.id})}]) %}{% endfor %}
<div class="dash-layout">
<div class="dash-main">
{% set routes = ['portal_appointments', 'portal_concerns', 'portal_services', 'portal_documents'] %}
<div class="metric-grid">
    {% for category in activity.categories %}
        <a class="metric-card" href="{{ path(routes[loop.index0]) }}"><span class="metric-icon metric-icon-{{ loop.index }}">{{ include('partials/_icon.html.twig', {name: category.icon}) }}</span><div><p class="metric-label">{{ category.label }}</p><strong class="metric-value">{{ category.total }}</strong><span class="metric-caption">{{ category.open }} open &middot; {{ category.closed }} closed</span></div></a>
    {% endfor %}
</div>
{{ include('partials/_activity_charts.html.twig') }}
    <section class="panel">
        <div class="panel-header"><div><h2 class="panel-title">Announcements</h2><p class="panel-kicker">University and campus updates</p></div><a class="panel-link" href="{{ path('portal_announcements') }}">View all &rarr;</a></div>
        <ul class="activity-feed">
            {% for item in announcements %}
            <li><span class="feed-icon">{{ include('partials/_icon.html.twig', {name: 'announcement'}) }}</span><div><h3>{{ item.title }}</h3><p>{{ item.body|length > 180 ? item.body|slice(0, 180) ~ '…' : item.body }}</p><time datetime="{{ item.publishedAt|date('c') }}">{{ item.publishedAt|date('M j, Y') }}</time></div></li>
            {% else %}<li class="empty-state">No announcements for your campus yet.</li>{% endfor %}
        </ul>
    </section>
</div>
<aside class="dash-aside" aria-label="Schedule and shortcuts">
    {{ include('partials/_promo_card.html.twig', {kicker: 'CARE counseling', title: 'Someone to talk to', text: 'Confidential guidance and support from the SAS counselors.', cta: 'Request support', route: 'portal_care'}) }}
    {{ include('partials/_calendar_widget.html.twig', {events: events, calendar_route: 'portal_appointments'}) }}
</aside>
</div>
{% endblock %}
