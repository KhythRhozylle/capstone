{% block password_widget %}
    {% set type = 'password' %}
    {% set attr = attr|merge({'data-password-visibility-target': 'input'}) %}
    <div class="password-field" data-controller="password-visibility" data-action="turbo:before-cache@document->password-visibility#hide">
        {{ block('form_widget_simple') }}
        {% include 'security/_password_toggle.html.twig' with {password_id: id} only %}
    </div>
{% endblock %}
