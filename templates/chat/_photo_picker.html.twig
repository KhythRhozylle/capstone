<div class="chat-photo-control" title="Attach a photo (JPG, PNG or WebP, up to 2 MB)">
    <span class="chat-attach-button" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m4 17 5-5 4 3 4-5 4 4"/></svg></span>
    {{ form_label(form.photo, 'Attach a photo', {label_attr: {class: 'chat-sr-only'}}) }}
    {{ form_widget(form.photo, {attr: {class: 'chat-photo-input', 'data-chat-photo-target': 'input', 'data-action': 'change->chat-photo#select'}}) }}
</div>
