{% extends 'layouts/app.html.twig' %}

{% block body_class %}portal workspace-page{% endblock %}

{% set workspace_title = 'Student portal' %}
{% set workspace_label = 'Student' %}
{% set workspace_home = 'portal_dashboard' %}
{% set notification_count = notification_unread_count(app.user) %}
{% set current_route = app.request.attributes.get('_route') %}
{% set groups = [
    {label: 'My workspace', items: [
        {label: 'Dashboard', route: 'portal_dashboard', icon: 'dashboard', active: current_route == 'portal_dashboard'}
    ]},
    {label: 'Student services', items: [
        {label: 'Appointments', route: 'portal_appointments', icon: 'clock', active: current_route starts with 'portal_appointment'},
        {label: 'Service requests', route: 'portal_services', icon: 'request', active: current_route starts with 'portal_service'},
        {label: 'Concerns', route: 'portal_concerns', icon: 'chat', active: current_route starts with 'portal_concern'},
        {label: 'CARE counseling', route: 'portal_care', icon: 'care', active: current_route starts with 'portal_care'},
        {label: 'Document tracking and monitoring', route: 'portal_documents', icon: 'document', active: current_route starts with 'portal_document'}
    ]},
    {label: 'Updates', items: [
        {label: 'Documentation guide', route: 'documentation_index', icon: 'document', active: current_route starts with 'documentation_'},
        {label: 'Announcements', route: 'portal_announcements', icon: 'announcement', active: current_route == 'portal_announcements'}
    ]}
] %}
{% set sidebar %}{% include 'partials/_sidebar.html.twig' with {label: 'Student navigation', groups: groups} only %}{% endset %}
