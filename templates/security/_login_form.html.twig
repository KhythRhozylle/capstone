{# Shared by the /login page and the landing-page sign-in modal. #}
<img class="auth-card-logo" src="{{ asset('images/sas-logo.png') }}" alt="NORSU SAS">
<h2 id="login-title">Log in to your account</h2>

{% if error|default(null) %}
    <div class="flash flash-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
{% endif %}

<form method="post" action="{{ path('app_login') }}" class="auth-form">
    <label for="username">Email address</label>
    <div class="input-wrap">
        <span class="input-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
        </span>
        <input type="email" id="username" name="_username" value="{{ last_username|default('') }}" placeholder="Enter your email" required autocomplete="username" {{ autofocus|default(false) ? 'autofocus' }} {{ stimulus_target('login-morph', 'email') }}>
    </div>

    <label for="password">Password</label>
    <div class="input-wrap">
        <span class="input-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
        </span>
        <input type="password" id="password" name="_password" placeholder="Enter your password" required autocomplete="current-password">
    </div>

    <div class="auth-row">
        <label class="checkbox"><input type="checkbox" name="_remember_me" checked> Remember me</label>
    </div>

    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
    <button class="btn btn-gold" type="submit">Log in</button>
</form>

<p class="auth-footer">Don’t have an account? <a href="{{ path('app_register') }}">Sign up</a></p>
<p class="auth-demo">Demo student: <code>student@norsu.edu.ph</code> · <code>Password123!</code></p>
