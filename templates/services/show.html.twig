{% extends 'layouts/landing.html.twig' %}

{% block title %}{{ service.name }} · NORSU-SAS Insight{% endblock %}
{% block page_class %}service-detail-page{% endblock %}

{% block main %}
    <section class="landing-section about-us service-detail-intro" aria-labelledby="service-title">
        <div class="landing-container about-us-grid">
            <div class="about-us-copy" data-reveal>
                <a class="service-back" href="{{ path('app_home') }}#services">Back</a>
                <p class="eyebrow eyebrow-dark">Student Affairs &amp; Services &middot; {{ service.code }}</p>
                <h1 id="service-title" class="about-us-title service-detail-title">{{ service.name }}</h1>
                <span class="about-us-rule" aria-hidden="true"></span>
                <p class="section-lead">{{ service.summary }}</p>
                <div class="service-detail-copy">
                    <p class="service-detail-text">{{ service.description }}</p>
                    <p class="service-detail-focus"><strong>Our focus</strong><span>{{ service.focus }}</span></p>
                </div>
                <a class="btn about-us-btn" href="{{ path('app_contact') }}">Contact us</a>
            </div>
            <div class="about-us-art" data-reveal style="--d: .1s">
                {{ include('partials/_about_art.html.twig') }}
            </div>
        </div>
    </section>

    <section class="landing-section service-people" aria-labelledby="service-director-name" data-controller="profile">
        <div class="landing-container" data-controller="office-team">
            <div class="vpsas-leader" data-reveal>
                <p class="eyebrow eyebrow-dark">Our director</p>
                <button type="button" class="vpsas-face" data-office-team-target="trigger" data-action="office-team#toggle"
                        aria-expanded="false" aria-controls="service-heads"
                        aria-label="{{ service.director.name }}. Show or hide the unit heads">
                    <img src="{{ asset(service.director.image) }}" width="300" height="300" alt="Portrait of {{ service.director.name }}">
                </button>
                <h2 id="service-director-name" class="vpsas-name">{{ service.director.name }}</h2>
                <p class="vpsas-position">{{ service.director.role }}</p>
                <p class="vpsas-hint">Select the portrait to meet the unit heads.</p>
            </div>
            <div id="service-heads" class="vpsas-team" data-office-team-target="panel" hidden>
                {% for head in service.heads %}
                    <article class="vpsas-member">
                        <button type="button" class="vpsas-member-btn" data-action="profile#open" data-profile-template-param="head-{{ loop.index }}"
                                aria-haspopup="dialog" aria-label="View the profile of {{ head.name }}">
                            <img src="{{ asset(head.image) }}" width="300" height="300" alt="Portrait of {{ head.name }}" loading="lazy">
                            <h3>{{ head.name }}</h3>
                            <p>{{ head.role }}</p>
                            <span class="vpsas-member-summary">{{ head.summary }}</span>
                            <span class="vpsas-member-more">View profile</span>
                        </button>
                        <template id="head-{{ loop.index }}">
                            <div class="profile-layout">
                                <div class="profile-person">
                                    <img class="profile-photo" src="{{ asset(head.image) }}" width="300" height="300" alt="Portrait of {{ head.name }}">
                                    <p class="eyebrow eyebrow-dark">{{ service.code }} &middot; Unit Head</p>
                                    <h2 class="profile-name" data-profile-title>{{ head.name }}</h2>
                                    <p class="profile-position">{{ head.role }}</p>
                                    <p class="profile-summary">{{ head.summary }} {{ head.responsibilities }}</p>
                                    <p class="profile-services-label">Other services</p>
                                    <ul class="profile-services">{% for item in head.services %}<li>{{ item }}</li>{% endfor %}</ul>
                                </div>
                                <div class="profile-about">
                                    {% for photo in head.photos %}
                                        <img class="profile-tile" src="{{ asset(photo) }}" alt="{{ head.unit }}, photo {{ loop.index }}" width="400" height="300" loading="lazy">
                                    {% endfor %}
                                </div>
                            </div>
                        </template>
                    </article>
                {% endfor %}
            </div>
        </div>

        <div class="profile-modal" data-profile-target="modal" hidden role="dialog" aria-modal="true" aria-label="Unit head profile"
             data-action="click->profile#backdrop keydown.esc->profile#close">
            <div class="profile-card" data-profile-target="card" tabindex="-1">
                <button type="button" class="profile-close" aria-label="Close profile" data-action="profile#close" data-profile-target="close">&times;</button>
                <div class="profile-body" data-profile-target="body"></div>
            </div>
        </div>
    </section>

    <section class="landing-section landing-section-alt" aria-labelledby="service-help-heading">
        <div class="landing-container service-help" data-reveal>
            <div>
                <p class="eyebrow eyebrow-dark">Your next step</p>
                <h2 id="service-help-heading">Get help from {{ service.code }}</h2>
                <p class="section-lead">Sign in to choose a SAS unit, book an appointment or submit a request. You can follow its status in your student portal. If you are unsure where to start, contact the SAS office for help finding the right unit.</p>
            </div>
            <div class="service-help-actions">
                <a class="btn" href="{{ path('app_login') }}" data-action="login-morph#open">Sign in to get help</a>
                <a class="btn btn-outline" href="{{ path('app_contact') }}">Contact SAS</a>
            </div>
        </div>
    </section>

    <section class="landing-section service-related" aria-labelledby="service-related-heading">
        <div class="landing-container" data-reveal>
            <p class="eyebrow eyebrow-dark">Explore student support</p>
            <h2 id="service-related-heading">Our three directorates</h2>
            <nav class="service-related-links" aria-label="Student service directorates">
                {% for other in services %}
                    <a href="{{ path(other.route) }}"{% if other.code == service.code %} aria-current="page"{% endif %}>
                        <span class="campus-code">{{ other.code }}</span>
                        <span>{{ other.name }}</span>
                        <span aria-hidden="true">&#8594;</span>
                    </a>
                {% endfor %}
            </nav>
        </div>
    </section>
{% endblock %}
